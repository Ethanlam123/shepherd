{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shepherd",
  "version": "0.1.0",
  "identifier": "local.shepherd.panel",
  "build": {
    "beforeDevCommand": "npm run build:ui && npm run sidecar",
    "beforeBuildCommand": "npm run build:ui && npm run sidecar",
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Shepherd",
        "width": 400,
        "height": 660,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "focus": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/shepherd/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0QzExQTJCOTYxMkI3RTUKUldUbHR4S1dLeHJCMVBWd3NFWlZVR1E3b0F2QVNnQWtudG9HNHlVODBJYmc4SXV4M2NSTDhaUkEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/shepherd-hook"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
